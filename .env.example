# Supabase pooled connection for app runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&schema=public"

# Supabase direct/session connection for migrations and introspection.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&schema=public"

# Supabase Storage for admin uploads.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="menu-images"

# Long random value used to sign admin session cookies (minimum 32 characters).
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Public production origin used to build password-reset links. Never derive this from request headers.
APP_URL="https://your-domain.example"

# Optional comma-separated aliases accepted for admin requests, such as a www domain.
# Keep this empty when APP_URL and the deployed request host cover every public origin.
ADMIN_ALLOWED_ORIGINS="https://www.your-domain.example"

# Transactional email used for admin security messages.
RESEND_API_KEY="re_REPLACE_ME"
AUTH_EMAIL_FROM="Hoa Phuong Do Security <security@your-domain.example>"
